# KaamLok Backend Environment
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kaamlok

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# One-time password (OTP) settings.
OTP_LENGTH=6
# How long an OTP stays valid. Default = 10. A 5-minute window expired while a
# user was still reading the email, so it was raised.
OTP_EXPIRY_MINUTES=10

# Cookie
COOKIE_SAMESITE=lax

# Rate limiting (protects login/registration/OTP against credential-stuffing).
# Defaults are dev-safe so you won't lock yourself out — they can be tightened
# per environment without code changes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=50

# ─────────────────────────────────────────────────────────────
# Email delivery (OTP / verification / password reset)
#
# EMAIL_PROVIDER selects the transport. Everything else below only
# applies to the provider you choose.
#
#   smtp    — any SMTP relay (Gmail, SendGrid, Zoho, SES SMTP). Default.
#   ses     — Amazon SES v2 API (needs `npm i @aws-sdk/client-sesv2`).
#   sns     — Amazon SNS email channel (needs `npm i @aws-sdk/client-sns`).
#   console — no network; renders the message to stdout. Dev only.
#
# Leave EMAIL_PROVIDER unset and it resolves to `smtp` when SMTP_USER and
# SMTP_PASS are both present, otherwise `console`.
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console

# Shared by every provider — must be an identity you have verified
# with the provider (SES verifies it, Gmail accepts it, etc).
EMAIL_FROM=KaamLok <no-reply@kaamlok.in>

# ── smtp ───────────────────────────────────────────────────────
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── ses / sns ─────────────────────────────────────────────────
# Prefer the SDK credential chain (instance profile / ECS task role /
# IMDS) and leave the keys blank.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Required only for EMAIL_PROVIDER=sns.
AWS_SNS_EMAIL_TOPIC_ARN=

# CORS
CLIENT_ORIGIN=http://localhost:3000